# mcp-nano configuration.
#
# Edit this file directly. Dev builds read it from the repo root (or
# src-tauri/); installed builds read the .env next to the executable.
# Real environment variables always win over values in this file.
# Every value below shows its default; unset variables use the default.

# --- Embedding ---------------------------------------------------------------

# Force embedding inference onto the CPU instead of auto-selected GPU.
#MCP_NANO_DEVICE=cpu

# Chunk size (tokens) and overlap for document/website text splitting.
#DOC_CHUNK_SIZE=768
#DOC_CHUNK_OVERLAP=50

# --- Website crawling --------------------------------------------------------

# Max pages fetched to validate links during a crawl (0 = unlimited).
#WEBSITE_CRAWL_MAX_PAGES=1000

# Max sitemap files followed per crawl (sitemap indexes count too).
#WEBSITE_CRAWL_MAX_SITEMAPS=512

# Max URLs collected from sitemaps.
#WEBSITE_CRAWL_MAX_SITEMAP_URLS=250000

# Concurrent page scrapes while embedding a website. Browser (JavaScript)
# renders are CPU-heavy: defaults are 4 with rendering, 8 without.
WEBSITE_SCRAPE_CONCURRENCY=8

# Explicit path to a Chromium-family browser for JavaScript rendering.
# Auto-detects browsers on PATH (Linux, snap, Windows power users) and in
# default Windows install locations (Chrome preferred, then Edge/Chromium).
#WEBSITE_BROWSER_PATH=/usr/bin/chromium

# --- Logging -----------------------------------------------------------------

# Log filter (tracing/RUST_LOG syntax), e.g. info,mcp_nano=debug.
#RUST_LOG=info
