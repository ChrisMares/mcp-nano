{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Development Debug (GPU)",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./src-tauri/Cargo.toml",
          "--features",
          "gpu"
        ]
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:dev",
      "env": {
        "RUST_LOG": "info,mcp_nano_lib=debug",
        "RUST_BACKTRACE": "1",
        "ORT_CUDA_VERSION": "12"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Development Debug (CPU)",
      "cargo": {
        "args": [
          "build",
          "--manifest-path=./src-tauri/Cargo.toml"
        ]
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:dev",
      "env": {
        "RUST_LOG": "info,mcp_nano_lib=debug",
        "RUST_BACKTRACE": "1",
        "MCP_NANO_DEVICE": "cpu"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Tauri Production Debug (GPU)",
      "cargo": {
        "args": [
          "build",
          "--release",
          "--manifest-path=./src-tauri/Cargo.toml",
          "--features",
          "gpu"
        ]
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:build",
      "env": {
        "RUST_LOG": "info,mcp_nano_lib=debug",
        "RUST_BACKTRACE": "1",
        "ORT_CUDA_VERSION": "12"
      }
    }
  ]
}
